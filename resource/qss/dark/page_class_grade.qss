QFrame#frameQueryCard, QFrame#frameResultCard {
    background-color: #2c2c2c;
    border-radius: 10px;
    border: 1px solid #444;
}

QLabel {
    color: #dddddd;
}

QListWidget {
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px;
    background-color: #1e1e1e;
    color: #dddddd;
}

QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #3a3a3a;
}

QListWidget::item:hover {
    background-color: #353535;
}

QListWidget::item:selected {
    background-color: #3f578f;
    color: white;
    border-left: 3px solid #70d5f3;
}

QTableWidget {
    border: 1px solid #444;
    border-radius: 4px;
    gridline-color: #666;
    color: #dddddd;
    background-color: #1e1e1e;
}

QHeaderView::section {
    background-color: #3c3c3c;
    padding: 5px;
    border: none;
    min-height: 30px;
    color: #eeeeee;
}

QLineEdit {
    background-color: #1e1e1e;
    color: #dddddd;
    border: 1px solid #666;
    border-radius: 4px;
    padding: 4px;
}

QWidget#widgetChart {
    background-color: #2a2a2a;
}
