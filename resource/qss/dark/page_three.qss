QWidget#leftFrame, QWidget#rightFrame {
    background-color: #2c2c2c;
    border-radius: 8px;
    padding: 12px;
    border: 1px solid #444;
}

QLabel#labelTitle {
    color: #dddddd;
    font-size: 14px;
    font-weight: bold;
}

QListView {
    border: 1px solid #444;
    border-radius: 6px;
    padding: 4px;
    background-color: #1e1e1e;
    color: #dddddd;
}

QListView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #3a3a3a;
}

QListView::item:hover {
    background-color: #353535;
}

QListView::item:selected {
    background-color: #3f578f;
    color: white;
    border-left: 3px solid #70d5f3;
}

QTableView {
    border: 1px solid #444;
    border-radius: 4px;
    gridline-color: #666;
    color: #dddddd;
    background-color: #1e1e1e;
}

QHeaderView::section {
    background-color: #3c3c3c;
    padding: 5px;
    border: none;
    min-height: 80px;
    min-width: 40px;
    color: #eeeeee;
}
