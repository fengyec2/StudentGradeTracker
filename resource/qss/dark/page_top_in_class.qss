QFrame#leftPanel, QFrame#rightPanel {
    background-color: #2c2c2c;
    border-radius: 8px;
    padding: 10px;
    border: 1px solid #444;
}

QLabel {
    color: #dddddd;
}

QListView {
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px;
    background-color: #1e1e1e;
    color: #dddddd;
}

QListView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #3a3a3a;
}

QListView::item:hover {
    background-color: #353535;
}

QListView::item:selected {
    background-color: #3f578f;
    color: white;
    border-left: 3px solid #70d5f3;
}

QComboBox {
    background-color: #1e1e1e;
    border: 1px solid #666;
    padding: 5px;
    border-radius: 4px;
    color: #dddddd;
}

QComboBox:hover {
    border: 1px solid #70d5f3;
}

QWidget#widgetChart {
    background-color: #2a2a2a;
}
