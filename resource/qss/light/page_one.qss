QWidget#leftPanel, QWidget#rightPanel, QWidget#upperRightPanel {
    background-color: white;
    border-radius: 12px;
    padding: 12px;
}

QLabel {
    color: #2e2e2e;
    font-size: 14px;
}

QListView {
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    padding: 4px;
    background-color: #ffffff;
    color: #2e2e2e;
}

QListView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #ebeef5;
}
QListView::item:hover {
    background-color: #f5f7fa;
}
QListView::item:selected {
    background-color: #ecf5ff;
    color: #409eff;
    border-left: 3px solid #409eff;
}

QTableView {
    border: 1px solid #ddd;
    border-radius: 6px;
    gridline-color: #f0f0f0;
    background-color: white;
    color: #2e2e2e;
}

QHeaderView::section {
    background-color: #f7f7f7;
    padding: 5px;
    border: none;
    min-height: 40px;
    font-weight: bold;
}
